# Copy to .env (gitignored) next to docker-compose.yml.
HOST_UID=1000                 # id -u
HOST_GID=1000                 # id -g
COGNIBOT_VERSION=dev

# ROS
ROS_DOMAIN_ID=42
ROBOT=so101                   # so101 | panda

# VLM (llama-swap profile names, see llm/config.yaml)
LLM_MODEL=qwen3-vl-4b-gpu

# VLA — pin the policy-server image by digest in P5-T01
LEROBOT_GPU_IMAGE=huggingface/lerobot-gpu:latest
VLA_CHECKPOINT=lerobot/smolvla_base
HF_TOKEN=                     # only for gated checkpoints

# Digital twin
TWIN_HARDWARE=mock            # mock | real
TWIN_SERIAL_DEVICE=/dev/ttyACM0
