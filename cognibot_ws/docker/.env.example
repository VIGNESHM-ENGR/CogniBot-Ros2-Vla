# Copy to .env (gitignored) next to docker-compose.yml.
HOST_UID=1000                 # id -u
HOST_GID=1000                 # id -g
COGNIBOT_VERSION=dev

# ROS
ROS_DOMAIN_ID=42
ROBOT=so101                   # so101 | panda
ROBOT_COLOR=red               # red | stock (stock = colors sim policies were trained on)

# VLM (llama-swap profile names, see llm/config.yaml)
LLM_MODEL=qwen3-vl-4b-gpu

# VLA — pin the policy-server image by digest in P5-T01
LEROBOT_GPU_IMAGE=huggingface/lerobot-gpu@sha256:7f36ab17a87911c79ad0856bdfa2bf0d9b92ce03d677a3ef41a9d91bc659ed6b
# Policy run by `make skill` (see cognibot_vla/scripts/run_robot_client.sh for all variables)
POLICY_TYPE=smolvla
VLA_CHECKPOINT=/hf_cache/cognibot/smolvla_mujoco_tray   # server-side path; uncompiled variant from download_checkpoints.sh
ACTION_DEGREES=true
HF_TOKEN=                     # only for gated checkpoints

# Digital twin
TWIN_HARDWARE=mock            # mock | real
TWIN_SERIAL_DEVICE=/dev/ttyACM0
