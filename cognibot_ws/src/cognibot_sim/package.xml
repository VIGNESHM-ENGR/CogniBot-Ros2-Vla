<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cognibot_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo simulation assets and wiring: robot registry, MJCF scenes, ros2_control descriptions and controller configs.</description>
  <maintainer email="vigneshm1engr@gmail.com">Vignesh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>mujoco_ros2_control</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>parallel_gripper_action_controller</exec_depend>
  <exec_depend>cognibot_common</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>so101_description</exec_depend>
  <exec_depend>moveit_resources_panda_description</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>trajectory_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
