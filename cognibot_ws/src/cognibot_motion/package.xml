  <?xml version="1.0"?>
  <?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
  <package format="3">
    <name>cognibot_motion</name>
    <version>0.1.0</version>
    <description>Motion and safety: control-mode manager, sphere-based safety filter, reachability query and fetch/place action server.</description>
    <maintainer email="vigneshm1engr@gmail.com">Vignesh</maintainer>
    <license>Apache-2.0</license>

    <exec_depend>rclpy</exec_depend>
<exec_depend>sensor_msgs</exec_depend>
<exec_depend>std_msgs</exec_depend>
<exec_depend>visualization_msgs</exec_depend>
<exec_depend>diagnostic_msgs</exec_depend>
<exec_depend>controller_manager_msgs</exec_depend>
<exec_depend>control_msgs</exec_depend>
<exec_depend>cognibot_interfaces</exec_depend>
<exec_depend>cognibot_common</exec_depend>

    <test_depend>python3-pytest</test_depend>

    <export>
      <build_type>ament_python</build_type>
    </export>
  </package>
