      "name": "Membrane Key",
      "kind": "button",
      "refersTo": "membrane-key",
      "description": "Every pressable control: legend, key cap, optional LED.",
      "html": "<button class=\"ds-key\"><span class=\"ds-led\"></span><span class=\"ds-legend\">Rest</span><span class=\"ds-cap\">R</span></button>",
      "css": ".ds-key{display:flex;align-items:center;gap:8px;min-height:44px;padding:8px 10px;border:0;border-radius:7px;background:#33383b;color:#ebe8e1;box-shadow:inset 0 1px 0 #454b4f,0 2px 0 #1a1d1f,0 3px 6px rgba(0,0,0,.45);cursor:pointer;transition:transform 80ms ease-out,box-shadow 80ms ease-out}.ds-key:hover{background:#3a4043}.ds-key:active{transform:translateY(2px);box-shadow:inset 0 1px 0 #454b4f,0 1px 2px rgba(0,0,0,.45)}.ds-key:focus-visible{outline:2px solid #f4c20d;outline-offset:3px}.ds-legend{flex:1;font:600 14px 'Barlow Condensed',system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase}.ds-cap{padding:1px 5px;border-radius:4px;background:#1a1d1f;color:#b4bab7;font:600 12px 'Barlow Condensed',system-ui,sans-serif}.ds-led{width:8px;height:8px;border-radius:50%;background:#2b3134}.ds-key:active .ds-led{background:#5ee08f}"
    },
    {
      "name": "Dead Key",
      "kind": "button",
      "refersTo": "membrane-key-dead",
      "description": "A key the current mode or state does not allow.",
      "html": "<button class=\"ds-key-dead\" aria-disabled=\"true\"><span class=\"ds-legend\">+X</span><span class=\"ds-cap\">W</span></button>",
      "css": ".ds-key-dead{display:flex;align-items:center;gap:8px;min-height:44px;padding:8px 10px;border:0;border-radius:7px;background:#26292b;color:#5c6461;box-shadow:inset 0 1px 0 #2d3133,0 2px 0 #1a1d1f;cursor:not-allowed}.ds-key-dead:focus-visible{outline:2px solid #f4c20d;outline-offset:3px}.ds-key-dead .ds-legend{flex:1;font:600 14px 'Barlow Condensed',system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase}.ds-key-dead .ds-cap{padding:1px 5px;border-radius:4px;background:#1a1d1f;font:600 12px 'Barlow Condensed',system-ui,sans-serif}"
    },
    {
