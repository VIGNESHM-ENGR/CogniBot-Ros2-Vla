      "refersTo": "stop-mushroom",
      "description": "Latching stop on its yellow plate, bound to Esc.",
      "html": "<div class=\"ds-stop\"><button class=\"ds-mushroom\">STOP</button><span class=\"ds-state\">Run</span></div>",
      "css": ".ds-stop{display:grid;justify-items:center;gap:10px;width:220px;padding:16px 12px;border-radius:12px;background:#f4c20d;color:#1a1500;box-shadow:inset 0 -3px 0 #b88f00,0 3px 8px rgba(0,0,0,.45)}.ds-mushroom{width:112px;height:112px;border:0;border-radius:50%;background:#d7261e;color:#fff;font:700 22px 'Barlow Condensed',system-ui,sans-serif;letter-spacing:.12em;box-shadow:inset 0 0 0 6px #7d130e,0 0 0 8px #151718,0 10px 16px rgba(0,0,0,.55);cursor:pointer;transition:transform 80ms ease-out}.ds-mushroom:active{transform:scale(.94)}.ds-mushroom:focus-visible{outline:2px solid #151718;outline-offset:12px}.ds-state{font:700 15px 'Barlow Condensed',system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase}"
    },
