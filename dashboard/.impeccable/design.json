      "css": ".ds-soft{display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:8px 14px;border:0;border-radius:7px;background:#3d4347;color:#ebe8e1;font:600 14px 'Barlow Condensed',system-ui,sans-serif;letter-spacing:.07em;text-transform:uppercase;box-shadow:inset 0 1px 0 #454b4f,inset 0 -3px 0 #f4c20d,0 2px 0 #1a1d1f,0 3px 6px rgba(0,0,0,.45);cursor:pointer}.ds-soft:focus-visible{outline:2px solid #f4c20d;outline-offset:3px}.ds-soft .ds-cap{padding:1px 5px;border-radius:4px;background:#1a1d1f;color:#b4bab7;font-size:12px}"
