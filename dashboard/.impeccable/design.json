      "html": "<button class=\"ds-dial\" aria-label=\"Mode key at MOTION\"><span class=\"ds-face\"></span><span class=\"ds-bar\"></span></button>",
      "css": ".ds-dial{position:relative;width:132px;height:132px;border:0;border-radius:50%;padding:0;background:#f4c20d;box-shadow:inset 0 -3px 0 #b88f00,0 3px 8px rgba(0,0,0,.5);cursor:pointer}.ds-dial:focus-visible{outline:2px solid #f4c20d;outline-offset:3px}.ds-face{position:absolute;inset:14px;border-radius:50%;background:#141617;box-shadow:inset 0 2px 6px rgba(0,0,0,.8)}.ds-bar{position:absolute;top:50%;left:50%;width:16px;height:78px;margin:-39px 0 0 -8px;border-radius:8px;background:#3b4144;transition:transform 110ms cubic-bezier(.16,1,.3,1)}.ds-bar::after{content:'';position:absolute;top:7px;left:50%;width:4px;height:18px;margin-left:-2px;border-radius:2px;background:#f4c20d}.ds-dial:hover .ds-bar{transform:rotate(30deg)}"
    },
    {
