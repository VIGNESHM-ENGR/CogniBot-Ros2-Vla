      "css": ".ds-joint{display:grid;gap:4px;width:260px;padding:12px 14px;border-radius:10px;background:#0e1214;color:#ebe8e1;font:400 13px Barlow,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-row{display:flex;justify-content:space-between}.ds-row span:first-child{color:#b4bab7}.ds-flag{color:#f4c20d;font:600 11px 'Barlow Condensed',system-ui,sans-serif;letter-spacing:.08em}.ds-track{position:relative;height:8px;border-radius:2px;background:#1f272b}.ds-marker{position:absolute;top:-2px;width:3px;height:12px;margin-left:-1.5px;border-radius:1px;background:#f4c20d}"
    },
    {
